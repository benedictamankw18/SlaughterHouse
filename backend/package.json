{
  "name": "ultbigboy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the UltBigBoy beat store",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "email:worker": "node scripts/email-worker.js",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node --test test/routes.integration.test.js",
    "test:browser": "playwright test -c playwright.config.js",
    "migrate:postgres": "node migrate-to-postgres.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "verify:backup": "node scripts/verify-backup.js",
    "storage:migrate": "node scripts/migrate-local-media.js",
    "optimize:images": "node scripts/optimize-images.js",
    "storage:audit": "node scripts/audit-media.js",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1"
  }
}
