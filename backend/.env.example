PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=ultbigboy
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYMENT_CALLBACK_URL=http://localhost:5500/frontend/payment-success.html
API_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5500
DOWNLOAD_SIGNING_SECRET=replace-with-a-long-random-secret
CERTIFICATE_SIGNING_SECRET=replace-with-a-different-long-random-secret
EMAIL_API_KEY=
EMAIL_FROM=
SQLITE_SOURCE_PATH=./data/app.db

# Alternatively, use one connection URL instead of the DB_* variables:
# MYSQL_URL=mysql://your_mysql_user:your_mysql_password@127.0.0.1:3306/ultbigboy
# TEST_MYSQL_URL=mysql://route_test:password%40123@127.0.0.1:3306/slaughterhouse_route_test

# Booking, custom-request, and default beat prices are stored in MySQL settings.
# Individual beat prices are stored in the beats basic_price/premium_price/
# unlimited_price/exclusive_price columns.
