PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://ultbigboy_app:replace-with-a-database-password@127.0.0.1:5432/ultbigboy
# Direct (unpooled) connection used by backup and restore scripts when
# DATABASE_URL points at a pooled endpoint such as Neon's.
# DATABASE_URL_UNPOOLED=postgresql://ultbigboy_app:replace-with-a-database-password@127.0.0.1:5432/ultbigboy
# Optional explicit direct connection for backups; takes priority over both.
# BACKUP_DATABASE_URL=postgresql://ultbigboy_app:replace-with-a-database-password@127.0.0.1:5432/ultbigboy
# Directory for local backup artifacts. Use a persistent path in deployments.
# BACKUP_DIR=./data/backups
# PostgreSQL pool size per process. Serverless deployments default to 3.
# DB_POOL_MAX=10
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYMENT_CALLBACK_URL=http://localhost:5500/payment-success.html
API_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5500
DOWNLOAD_SIGNING_SECRET=replace-with-a-long-random-secret
CERTIFICATE_SIGNING_SECRET=replace-with-a-different-long-random-secret
ADMIN_MFA_ENCRYPTION_KEY=replace-with-a-third-random-secret-at-least-32-characters
EMAIL_API_KEY=
EMAIL_FROM=
SQLITE_SOURCE_PATH=./data/app.db

# Media storage. "local" writes to backend/data; it only survives restarts when
# the filesystem is persistent (local development, Docker with a mounted volume).
# Production deployments with ephemeral disks must use "s3".
STORAGE_DRIVER=local
# ALLOW_EPHEMERAL_STORAGE=false
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=slaughterhouse-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# MEDIA_KEY_PREFIX=
# PUBLIC_MEDIA_BASE_URL=https://media.example.com

# The integration suite only accepts a local database with this dedicated name.
# TEST_DATABASE_URL=postgresql://ultbigboy_app:replace-with-a-test-password@127.0.0.1:5432/slaughterhouse_route_test
# When using the Docker Compose PostgreSQL service, use 127.0.0.1:5433 and the
# DB_USER/DB_PASSWORD values from the repository root .env instead.

# Booking, custom-request, and default beat prices are stored in PostgreSQL settings.
# Individual beat prices are stored in the beats basic_price/premium_price/
# unlimited_price/exclusive_price columns. A super-admin must configure
# usd_to_ghs_rate in Admin > Settings; it expires after 24 hours and beat
# checkout is disabled until a fresh rate is saved.


FLUTTERWAVE_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FLUTTERWAVE_WEBHOOK_HASH=replace-with-a-random-hash-at-least-32-characters
