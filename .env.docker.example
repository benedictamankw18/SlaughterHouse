# Copy this file to .env in the repository root and replace every example secret.
DB_USER=ultbigboy_app
DB_PASSWORD=replace-with-a-unique-database-password
POSTGRES_PORT=5433

API_PORT=3000
FRONTEND_PORT=5500
FRONTEND_ORIGIN=http://localhost:5500
FRONTEND_ORIGINS=
API_PUBLIC_URL=http://localhost:3000
PAYMENT_CALLBACK_URL=http://localhost:5500/payment-success.html

# Use different random values of at least 32 characters. Keep them stable to
# preserve download links and certificate verification across restarts.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
CERTIFICATE_SIGNING_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ADMIN_MFA_ENCRYPTION_KEY=replace-with-a-third-random-secret-at-least-32-characters

PAYSTACK_SECRET_KEY=
EMAIL_API_KEY=
EMAIL_FROM=
# The Compose frontend proxies /api to the backend, so trust one proxy hop.
# Set this to the actual number of trusted proxies when adding an outer TLS
# reverse proxy.
TRUST_PROXY=1

# Media storage. Keep "local" for local Docker: the app-data volume persists
# uploads. Staging and production deployments behind ephemeral disks must set
# "s3" and the S3_* values below; keep ALLOW_EPHEMERAL_STORAGE unset/false.
STORAGE_DRIVER=local
# ALLOW_EPHEMERAL_STORAGE=false
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=slaughterhouse-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# MEDIA_KEY_PREFIX=
# PUBLIC_MEDIA_BASE_URL=https://media.example.com
