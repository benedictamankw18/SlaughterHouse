    { "source": "/requests.html", "destination": "/user/requests.html", "permanent": true },
    { "source": "/wishlist.html", "destination": "/user/wishlist.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/beats.html", "destination": "/user/beats.html" },
    { "source": "/booking.html", "destination": "/user/booking.html" },
    { "source": "/merchandise.html", "destination": "/user/merchandise.html" },
