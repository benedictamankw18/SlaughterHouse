{
  "version": 2,
  "installCommand": "npm ci --omit=dev --prefix backend",
  "outputDirectory": "frontend",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self' 'sha256-XL78bdzNaXSWc4jvroFmjWfuAuS+6z4mV9+Zt+6nvoc='" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self' 'sha256-XL78bdzNaXSWc4jvroFmjWfuAuS+6z4mV9+Zt+6nvoc='" }
      ]
    },
    {
      "source": "/beats.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self'" }
      ]
    },
    {
      "source": "/booking.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self' 'sha256-+j/vp86x/OMAYV6Sp58ZlSC65wkk+5Ve/bFjq1yTiMg='" }
      ]
    },
    {
      "source": "/merchandise.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self' 'sha256-Wa0mLofalLRXmOknjihbnjJuHPypR8ufZx/3o4Eu2rI='" }
      ]
    },
    {
      "source": "/produced.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self'" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self'" }
      ]
    },
    {
      "source": "/payment-success.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "script-src 'self' 'sha256-KCiAR/UqL4hKFDOrshS93jEoHszBDINFgz9ts2p9hkY='" }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/[...path].js": {
      "maxDuration": 60
    }
  }
}
