      ]
    },
    {
      "source": "/404.html",
      "headers": [{ "key": "Content-Security-Policy", "value": "script-src 'self'" }]
    },
    {
      "source": "/alerts.html",
      "headers": [{ "key": "Content-Security-Policy", "value": "script-src 'self'" }]
    },
    {
      "source": "/bookings.html",
