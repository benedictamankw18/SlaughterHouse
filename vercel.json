{
  "version": 2,
  "installCommand": "npm ci --omit=dev --prefix backend",
  "outputDirectory": "frontend",
  "redirects": [
    { "source": "/admin.html", "destination": "/admin/admin.html", "permanent": true },
    { "source": "/alerts.html", "destination": "/user/alerts.html", "permanent": true },
    { "source": "/bookings.html", "destination": "/user/bookings.html", "permanent": true },
    { "source": "/downloads.html", "destination": "/user/downloads.html", "permanent": true },
